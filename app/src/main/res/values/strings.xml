    <!-- about screen -->
    <string name="about_title">About</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">A location mocking tool for developers and testers to test location-based features. Developed by DSAI (dsai.vn).</string>
    <string name="about_section_notes">Usage notes</string>
    <string name="about_notes">Mocked locations are always flagged as mock by Android (Location.isMock), so apps that check for it will notice. Use it only to test your own apps. Do not use it to cheat or to violate the terms of other services.</string>
    <string name="about_section_privacy">Privacy</string>
    <string name="about_privacy">No ads, no analytics, no accounts and no server of our own. Favorites and settings are stored only on your device. When you search, plan a route or view the map, the search text and related coordinates are sent directly to the services listed below.</string>
    <string name="about_privacy_policy">Privacy policy</string>
    <string name="about_section_third_party">Third-party services and data</string>
    <string name="about_third_party">• Map: OpenFreeMap, data © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Address search: Android Geocoder (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Routing: OSRM at routing.openstreetmap.de (FOSSGIS)\n• Libraries: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">OpenStreetMap copyright</string>
