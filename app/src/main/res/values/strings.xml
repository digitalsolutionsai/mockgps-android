    <!-- adb screen -->
    <string name="adb_title">Control with adb</string>
    <string name="adb_intro">Everything can be triggered from a computer, which is handy for automated tests. The service requires the android.permission.DUMP permission, so only this app and adb shell can control it; other apps cannot.</string>
