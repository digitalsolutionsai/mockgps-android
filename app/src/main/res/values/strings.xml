    <!-- setup -->
    <string name="setup_title">Setup</string>
    <string name="setup_intro">Android only lets an app mock the location once you select it in Developer options. You only need to do this once.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (optional)</string>
    <string name="setup_done">Done</string>
    <string name="setup_step1_title">Turn on Developer options</string>
    <string name="setup_step1_body">Settings → About phone → Software information → tap \"Build number\" 7 times.</string>
    <string name="setup_step1_action">Open About phone</string>
    <string name="setup_step2_title">Select MockGPS as the mock location app</string>
    <string name="setup_step2_body">In Developer options, find \"Select mock location app\" and choose MockGPS.</string>
    <string name="setup_step2_action">Open Developer options</string>
    <string name="setup_step3_title">Allow location and notifications</string>
    <string name="setup_step3_body">Location lets MockGPS also mock the fused source that most apps use. Notifications show the status and the Stop button.</string>
    <string name="setup_step3_action">Grant permissions</string>
    <string name="setup_step3_secondary">App settings</string>
    <string name="setup_step4_title">Display over other apps</string>
    <string name="setup_step4_body">Only needed if you use the floating joystick to move while another app is open.</string>
    <string name="setup_step4_action">Open settings</string>
    <string name="setup_step5_title">Unrestricted battery</string>
    <string name="setup_step5_body">Recommended on Samsung, Xiaomi and Oppo so the system doesn\'t stop mocking after the screen has been off for a long time.</string>
    <string name="setup_step5_action">Open battery settings</string>
    <string name="setup_quick_title">Quick setup with adb</string>
    <string name="setup_quick_body">Skip steps 2 and 3 when the phone is connected with a debug cable:</string>
    <string name="setup_start">Get started</string>
    <string name="setup_finish_steps">Complete steps 2 and 3 to continue</string>
