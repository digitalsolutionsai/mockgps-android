    <!-- adb screen -->
    <string name="adb_title">使用 adb 控制</string>
    <string name="adb_intro">所有操作都能從電腦觸發，很適合自動化測試。此服務需要 android.permission.DUMP 權限，因此只有本應用程式和 adb shell 可以控制，其他應用程式無法控制。</string>
