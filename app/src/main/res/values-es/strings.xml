    <!-- about screen -->
    <string name="about_title">Acerca de</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">Una herramienta de simulación de ubicación para desarrolladores y testers que prueban funciones basadas en la ubicación. Desarrollada por DSAI (dsai.vn).</string>
    <string name="about_section_notes">Notas de uso</string>
    <string name="about_notes">Android siempre marca las ubicaciones simuladas como mock (Location.isMock), así que las apps que lo comprueban lo detectarán. Úsala solo para probar tus propias apps. No la uses para hacer trampas ni para incumplir los términos de otros servicios.</string>
    <string name="about_section_privacy">Privacidad</string>
    <string name="about_privacy">Sin anuncios, sin analíticas, sin cuentas y sin servidor propio. Los favoritos y los ajustes se guardan solo en tu dispositivo. Cuando buscas, planificas una ruta o ves el mapa, el texto de búsqueda y las coordenadas relacionadas se envían directamente a los servicios que se indican abajo.</string>
    <string name="about_privacy_policy">Política de privacidad</string>
    <string name="about_section_third_party">Servicios y datos de terceros</string>
    <string name="about_third_party">• Mapa: OpenFreeMap, datos © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Búsqueda de direcciones: Android Geocoder (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Rutas: OSRM en routing.openstreetmap.de (FOSSGIS)\n• Bibliotecas: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">Copyright de OpenStreetMap</string>
