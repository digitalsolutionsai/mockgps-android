    <!-- setup -->
    <string name="setup_title">Configuración inicial</string>
    <string name="setup_intro">Android solo permite que una app simule la ubicación después de que la selecciones en Opciones de desarrollador. Solo tienes que hacerlo una vez.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (opcional)</string>
    <string name="setup_done">Listo</string>
    <string name="setup_step1_title">Activa las Opciones de desarrollador</string>
    <string name="setup_step1_body">Ajustes → Acerca del teléfono → Información del software → toca 7 veces \"Número de compilación\".</string>
    <string name="setup_step1_action">Abrir Acerca del teléfono</string>
    <string name="setup_step2_title">Selecciona MockGPS como app de ubicación simulada</string>
    <string name="setup_step2_body">En Opciones de desarrollador, busca \"Seleccionar app de ubicación simulada\" y elige MockGPS.</string>
    <string name="setup_step2_action">Abrir Opciones de desarrollador</string>
    <string name="setup_step3_title">Permite la ubicación y las notificaciones</string>
    <string name="setup_step3_body">La ubicación permite que MockGPS simule también la fuente fused, que usan la mayoría de las apps. Las notificaciones muestran el estado y el botón Detener.</string>
    <string name="setup_step3_action">Conceder permisos</string>
    <string name="setup_step3_secondary">Ajustes de la app</string>
    <string name="setup_step4_title">Mostrar sobre otras apps</string>
    <string name="setup_step4_body">Solo es necesario si usas el joystick flotante para moverte con otra app abierta.</string>
    <string name="setup_step4_action">Abrir ajustes</string>
    <string name="setup_step5_title">Batería sin restricciones</string>
    <string name="setup_step5_body">Recomendado en Samsung, Xiaomi y Oppo para que el sistema no detenga la simulación tras mucho tiempo con la pantalla apagada.</string>
    <string name="setup_step5_action">Abrir ajustes de batería</string>
    <string name="setup_quick_title">Configuración rápida con adb</string>
    <string name="setup_quick_body">Omite los pasos 2 y 3 si el teléfono está conectado con un cable de depuración:</string>
    <string name="setup_start">Empezar</string>
    <string name="setup_finish_steps">Completa los pasos 2 y 3 para continuar</string>
    <string name="setup_later">Más tarde</string>

