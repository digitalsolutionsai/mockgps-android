    <!-- about screen -->
    <string name="about_title">Giới thiệu</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">Công cụ giả lập vị trí cho developer và tester kiểm thử tính năng dựa trên vị trí. Phát triển bởi DSAI (dsai.vn).</string>
    <string name="about_section_notes">Lưu ý khi sử dụng</string>
    <string name="about_notes">Vị trí giả lập luôn được Android đánh dấu là mock (Location.isMock), nên ứng dụng có kiểm tra sẽ nhận ra. Chỉ dùng để kiểm thử ứng dụng của bạn. Không dùng để gian lận hoặc vi phạm điều khoản của dịch vụ khác.</string>
    <string name="about_section_privacy">Quyền riêng tư</string>
    <string name="about_privacy">Không quảng cáo, không phân tích hành vi, không tài khoản và không có máy chủ riêng. Điểm yêu thích và cài đặt chỉ lưu trên máy. Khi bạn tìm kiếm, tìm đường hoặc xem bản đồ, nội dung tìm kiếm và tọa độ liên quan được gửi trực tiếp tới các dịch vụ bên dưới.</string>
    <string name="about_privacy_policy">Chính sách quyền riêng tư</string>
    <string name="about_section_third_party">Dịch vụ và dữ liệu bên thứ ba</string>
    <string name="about_third_party">• Bản đồ: OpenFreeMap, dữ liệu © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Tìm địa chỉ: Geocoder của Android (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Tìm đường: OSRM tại routing.openstreetmap.de (FOSSGIS)\n• Thư viện: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">Bản quyền OpenStreetMap</string>
