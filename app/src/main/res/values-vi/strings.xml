    <string name="adb_title">Điều khiển bằng adb</string>
    <string name="adb_intro">Mọi thao tác đều gọi được từ máy tính, tiện cho test tự động. Dịch vụ yêu cầu quyền android.permission.DUMP, nên chỉ chính ứng dụng và adb shell điều khiển được, ứng dụng khác thì không.</string>
