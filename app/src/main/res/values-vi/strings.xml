    <!-- setup -->
    <string name="setup_title">Thiết lập</string>
    <string name="setup_intro">Android chỉ cho một ứng dụng giả lập vị trí khi bạn chọn nó trong Tùy chọn nhà phát triển. Chỉ cần làm một lần.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (tùy chọn)</string>
    <string name="setup_done">Đã xong</string>
    <string name="setup_step1_title">Bật Tùy chọn nhà phát triển</string>
    <string name="setup_step1_body">Cài đặt → Thông tin điện thoại → Thông tin phần mềm → chạm 7 lần vào \"Số hiệu bản tạo\".</string>
    <string name="setup_step1_action">Mở Thông tin điện thoại</string>
    <string name="setup_step2_title">Chọn MockGPS làm ứng dụng vị trí mô phỏng</string>
    <string name="setup_step2_body">Trong Tùy chọn nhà phát triển, tìm \"Chọn ứng dụng vị trí mô phỏng\" rồi chọn MockGPS.</string>
    <string name="setup_step2_action">Mở Tùy chọn nhà phát triển</string>
    <string name="setup_step3_title">Cho phép vị trí và thông báo</string>
    <string name="setup_step3_body">Vị trí để giả lập cả nguồn fused mà phần lớn ứng dụng dùng. Thông báo hiển thị trạng thái và nút Dừng.</string>
    <string name="setup_step3_action">Cấp quyền</string>
    <string name="setup_step3_secondary">Cài đặt ứng dụng</string>
    <string name="setup_step4_title">Hiển thị trên ứng dụng khác</string>
    <string name="setup_step4_body">Chỉ cần nếu bạn dùng joystick nổi để di chuyển khi đang mở ứng dụng khác.</string>
    <string name="setup_step4_action">Mở cài đặt</string>
    <string name="setup_step5_title">Không giới hạn pin</string>
    <string name="setup_step5_body">Nên bật trên Samsung, Xiaomi, Oppo để hệ thống không dừng giả lập khi tắt màn hình lâu.</string>
    <string name="setup_step5_action">Mở cài đặt pin</string>
    <string name="setup_quick_title">Thiết lập nhanh bằng adb</string>
    <string name="setup_quick_body">Bỏ qua bước 2 và 3 khi máy đang cắm cáp debug:</string>
    <string name="setup_start">Bắt đầu sử dụng</string>
    <string name="setup_finish_steps">Hoàn thành bước 2 và 3 để tiếp tục</string>
    <string name="setup_later">Để sau</string>

