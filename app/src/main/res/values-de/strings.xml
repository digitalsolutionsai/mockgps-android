    <string name="adb_route_params">by: road (Straßen folgen) oder leer lassen, um die Punkte mit einer geraden Linie zu verbinden · travel: foot, bike, motorbike, car · end: stop, loop, pingpong · speed: km/h.</string>
    <string name="adb_section_controls">Steuerung</string>
