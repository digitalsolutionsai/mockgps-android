    <!-- setup -->
    <string name="setup_title">Einrichtung</string>
    <string name="setup_intro">Android erlaubt einer App erst dann, den Standort zu simulieren, wenn du sie in den Entwickleroptionen auswählst. Das musst du nur einmal tun.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (optional)</string>
    <string name="setup_done">Fertig</string>
    <string name="setup_step1_title">Entwickleroptionen aktivieren</string>
    <string name="setup_step1_body">Einstellungen → Über das Telefon → Softwareinformationen → 7-mal auf \"Build-Nummer\" tippen.</string>
    <string name="setup_step1_action">Über das Telefon öffnen</string>
    <string name="setup_step2_title">MockGPS als App für simulierte Standorte auswählen</string>
    <string name="setup_step2_body">Suche in den Entwickleroptionen nach \"App für simulierte Standorte auswählen\" und wähle MockGPS aus.</string>
    <string name="setup_step2_action">Entwickleroptionen öffnen</string>
    <string name="setup_step3_title">Standort und Benachrichtigungen erlauben</string>
    <string name="setup_step3_body">Mit der Standortberechtigung kann MockGPS auch die Fused-Quelle simulieren, die die meisten Apps nutzen. Benachrichtigungen zeigen den Status und die Schaltfläche „Stopp“.</string>
    <string name="setup_step3_action">Berechtigungen erteilen</string>
    <string name="setup_step3_secondary">App-Einstellungen</string>
    <string name="setup_step4_title">Über anderen Apps einblenden</string>
    <string name="setup_step4_body">Nur nötig, wenn du den schwebenden Joystick nutzt, um dich zu bewegen, während eine andere App geöffnet ist.</string>
    <string name="setup_step4_action">Einstellungen öffnen</string>
    <string name="setup_step5_title">Akku uneingeschränkt</string>
    <string name="setup_step5_body">Empfohlen bei Samsung, Xiaomi und Oppo, damit das System die Simulation nicht beendet, wenn der Bildschirm lange aus ist.</string>
    <string name="setup_step5_action">Akkueinstellungen öffnen</string>
    <string name="setup_quick_title">Schnelleinrichtung mit adb</string>
    <string name="setup_quick_body">Überspringe Schritt 2 und 3, wenn das Handy per Debug-Kabel verbunden ist:</string>
