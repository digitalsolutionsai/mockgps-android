    <!-- adb screen -->
    <string name="adb_title">Steuerung per adb</string>
    <string name="adb_intro">Alles lässt sich von einem Computer aus auslösen, praktisch für automatisierte Tests. Der Dienst erfordert die Berechtigung android.permission.DUMP, daher können nur diese App und die adb shell ihn steuern; andere Apps nicht.</string>
