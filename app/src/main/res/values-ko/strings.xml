    <!-- about screen -->
    <string name="about_title">정보</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">개발자와 테스터가 위치 기반 기능을 테스트할 수 있는 위치 모의 도구입니다. DSAI(dsai.vn)에서 개발했습니다.</string>
    <string name="about_section_notes">사용 시 유의사항</string>
    <string name="about_notes">모의 위치는 항상 Android에서 모의로 표시되므로(Location.isMock) 이를 확인하는 앱은 알아챌 수 있습니다. 본인 앱을 테스트하는 용도로만 사용하세요. 부정행위나 다른 서비스의 약관 위반에는 사용하지 마세요.</string>
    <string name="about_section_privacy">개인정보 보호</string>
    <string name="about_privacy">광고, 분석, 계정, 자체 서버가 없습니다. 즐겨찾기와 설정은 기기에만 저장됩니다. 검색하거나 경로를 계획하거나 지도를 볼 때 검색어와 관련 좌표가 아래 서비스로 직접 전송됩니다.</string>
    <string name="about_privacy_policy">개인정보 처리방침</string>
    <string name="about_section_third_party">서드파티 서비스 및 데이터</string>
    <string name="about_third_party">• 지도: OpenFreeMap, 데이터 © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• 주소 검색: Android Geocoder(Google), Photon(komoot), Nominatim(OpenStreetMap)\n• 경로 검색: routing.openstreetmap.de의 OSRM(FOSSGIS)\n• 라이브러리: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">OpenStreetMap 저작권</string>
</resources>
