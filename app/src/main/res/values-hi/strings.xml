    <!-- setup -->
    <string name="setup_title">सेटअप</string>
    <string name="setup_intro">Android में कोई ऐप तभी लोकेशन मॉक कर सकता है, जब आप उसे डेवलपर विकल्प में चुन लें। यह सिर्फ़ एक बार करना होता है।</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (ज़रूरी नहीं)</string>
    <string name="setup_done">हो गया</string>
    <string name="setup_step1_title">डेवलपर विकल्प चालू करें</string>
    <string name="setup_step1_body">सेटिंग → फ़ोन के बारे में → सॉफ़्टवेयर की जानकारी → \"बिल्ड नंबर\" पर 7 बार टैप करें।</string>
    <string name="setup_step1_action">फ़ोन के बारे में खोलें</string>
    <string name="setup_step2_title">MockGPS को मॉक लोकेशन ऐप चुनें</string>
    <string name="setup_step2_body">डेवलपर विकल्प में \"मॉक लोकेशन ऐप चुनें\" ढूंढें और MockGPS चुनें।</string>
    <string name="setup_step2_action">डेवलपर विकल्प खोलें</string>
    <string name="setup_step3_title">लोकेशन और नोटिफ़िकेशन की अनुमति दें</string>
    <string name="setup_step3_body">लोकेशन की अनुमति से MockGPS उस Fused सोर्स को भी मॉक कर पाता है, जिसे ज़्यादातर ऐप इस्तेमाल करते हैं। नोटिफ़िकेशन में स्टेटस और रोकें बटन दिखता है।</string>
    <string name="setup_step3_action">अनुमतियां दें</string>
    <string name="setup_step3_secondary">ऐप सेटिंग</string>
    <string name="setup_step4_title">अन्य ऐप्स के ऊपर दिखाएं</string>
    <string name="setup_step4_body">यह सिर्फ़ तब ज़रूरी है, जब आप दूसरा ऐप खुला होने पर फ़्लोटिंग जॉयस्टिक से मूव करते हैं।</string>
    <string name="setup_step4_action">सेटिंग खोलें</string>
    <string name="setup_step5_title">बैटरी पर कोई पाबंदी नहीं</string>
    <string name="setup_step5_body">Samsung, Xiaomi और Oppo पर इसे चालू करने की सलाह दी जाती है, ताकि स्क्रीन काफ़ी देर बंद रहने पर सिस्टम मॉकिंग बंद न कर दे।</string>
    <string name="setup_step5_action">बैटरी सेटिंग खोलें</string>
    <string name="setup_quick_title">adb से तुरंत सेटअप</string>
    <string name="setup_quick_body">फ़ोन डीबग केबल से जुड़ा हो, तो चरण 2 और 3 छोड़ सकते हैं:</string>
