    <!-- about screen -->
    <string name="about_title">इस ऐप के बारे में</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">डेवलपर और टेस्टर के लिए लोकेशन मॉक करने वाला टूल, ताकि लोकेशन पर आधारित फ़ीचर टेस्ट किए जा सकें। DSAI (dsai.vn) द्वारा बनाया गया।</string>
    <string name="about_section_notes">इस्तेमाल से जुड़े नोट</string>
    <string name="about_notes">मॉक की गई लोकेशन को Android हमेशा मॉक के रूप में चिह्नित करता है (Location.isMock), इसलिए इसे जांचने वाले ऐप को पता चल जाएगा। इसे सिर्फ़ अपने ऐप टेस्ट करने के लिए इस्तेमाल करें। धोखाधड़ी करने या दूसरी सेवाओं की शर्तें तोड़ने के लिए इसका इस्तेमाल न करें।</string>
    <string name="about_section_privacy">निजता</string>
    <string name="about_privacy">कोई विज्ञापन नहीं, कोई एनालिटिक्स नहीं, कोई अकाउंट नहीं और हमारा अपना कोई सर्वर नहीं। पसंदीदा और सेटिंग सिर्फ़ आपके डिवाइस पर सेव रहती हैं। जब आप खोजते हैं, रूट बनाते हैं या मैप देखते हैं, तो खोज का टेक्स्ट और उससे जुड़े कोऑर्डिनेट सीधे नीचे दी गई सेवाओं को भेजे जाते हैं।</string>
