    <!-- setup -->
    <string name="setup_title">Penyiapan</string>
    <string name="setup_intro">Android hanya mengizinkan aplikasi mensimulasikan lokasi setelah Anda memilihnya di Opsi developer. Anda hanya perlu melakukannya sekali.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (opsional)</string>
    <string name="setup_done">Selesai</string>
    <string name="setup_step1_title">Aktifkan Opsi developer</string>
    <string name="setup_step1_body">Pengaturan → Tentang ponsel → Informasi perangkat lunak → ketuk \"Nomor build\" 7 kali.</string>
    <string name="setup_step1_action">Buka Tentang ponsel</string>
    <string name="setup_step2_title">Pilih MockGPS sebagai aplikasi lokasi palsu</string>
    <string name="setup_step2_body">Di Opsi developer, cari \"Pilih aplikasi lokasi palsu\" lalu pilih MockGPS.</string>
    <string name="setup_step2_action">Buka Opsi developer</string>
    <string name="setup_step3_title">Izinkan lokasi dan notifikasi</string>
    <string name="setup_step3_body">Izin lokasi memungkinkan MockGPS juga menyimulasikan sumber fused yang dipakai sebagian besar aplikasi. Notifikasi menampilkan status dan tombol Hentikan.</string>
    <string name="setup_step3_action">Berikan izin</string>
    <string name="setup_step3_secondary">Pengaturan aplikasi</string>
    <string name="setup_step4_title">Tampilkan di atas aplikasi lain</string>
    <string name="setup_step4_body">Hanya diperlukan jika Anda memakai joystick mengambang untuk bergerak saat aplikasi lain terbuka.</string>
    <string name="setup_step4_action">Buka pengaturan</string>
    <string name="setup_step5_title">Baterai tanpa batasan</string>
    <string name="setup_step5_body">Disarankan di Samsung, Xiaomi, dan Oppo agar sistem tidak menghentikan simulasi setelah layar mati dalam waktu lama.</string>
    <string name="setup_step5_action">Buka pengaturan baterai</string>
    <string name="setup_quick_title">Penyiapan cepat dengan adb</string>
    <string name="setup_quick_body">Lewati langkah 2 dan 3 jika ponsel terhubung dengan kabel debug:</string>
