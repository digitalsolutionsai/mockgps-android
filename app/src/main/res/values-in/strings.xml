    <!-- about screen -->
    <string name="about_title">Tentang</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">Alat simulasi lokasi untuk developer dan penguji guna menguji fitur berbasis lokasi. Dikembangkan oleh DSAI (dsai.vn).</string>
    <string name="about_section_notes">Catatan penggunaan</string>
    <string name="about_notes">Lokasi simulasi selalu ditandai sebagai mock oleh Android (Location.isMock), sehingga aplikasi yang memeriksanya akan mengetahuinya. Gunakan hanya untuk menguji aplikasi Anda sendiri. Jangan gunakan untuk berbuat curang atau melanggar ketentuan layanan lain.</string>
    <string name="about_section_privacy">Privasi</string>
    <string name="about_privacy">Tanpa iklan, tanpa analitik, tanpa akun, dan tanpa server sendiri. Favorit dan pengaturan hanya disimpan di perangkat Anda. Saat Anda mencari, merencanakan rute, atau melihat peta, teks pencarian dan koordinat terkait dikirim langsung ke layanan yang tercantum di bawah.</string>
    <string name="about_privacy_policy">Kebijakan privasi</string>
    <string name="about_section_third_party">Layanan dan data pihak ketiga</string>
    <string name="about_third_party">• Peta: OpenFreeMap, data © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Pencarian alamat: Android Geocoder (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Rute: OSRM di routing.openstreetmap.de (FOSSGIS)\n• Pustaka: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">Hak cipta OpenStreetMap</string>
