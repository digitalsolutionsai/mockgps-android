    <!-- adb screen -->
    <string name="adb_title">adb ile kontrol</string>
    <string name="adb_intro">Her şey bir bilgisayardan tetiklenebilir; bu, otomatik testler için kullanışlıdır. Hizmet android.permission.DUMP iznini gerektirir, bu yüzden onu yalnızca bu uygulama ve adb shell kontrol edebilir; diğer uygulamalar edemez.</string>
