    <!-- setup -->
    <string name="setup_title">Kurulum</string>
    <string name="setup_intro">Android, bir uygulamanın konumu simüle etmesine ancak onu Geliştirici seçeneklerinde seçtikten sonra izin verir. Bunu yalnızca bir kez yapmanız yeterli.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (isteğe bağlı)</string>
    <string name="setup_done">Bitti</string>
    <string name="setup_step1_title">Geliştirici seçeneklerini açın</string>
    <string name="setup_step1_body">Ayarlar → Telefon hakkında → Yazılım bilgileri → \"Derleme numarası\" öğesine 7 kez dokunun.</string>
    <string name="setup_step1_action">Telefon hakkında sayfasını aç</string>
    <string name="setup_step2_title">MockGPS\'i sahte konum uygulaması olarak seçin</string>
    <string name="setup_step2_body">Geliştirici seçeneklerinde \"Sahte konum uygulamasını seçin\" öğesini bulun ve MockGPS\'i seçin.</string>
    <string name="setup_step2_action">Geliştirici seçeneklerini aç</string>
    <string name="setup_step3_title">Konuma ve bildirimlere izin verin</string>
    <string name="setup_step3_body">Konum izni, MockGPS\'in çoğu uygulamanın kullandığı fused kaynağını da simüle etmesini sağlar. Bildirimler durumu ve Durdur düğmesini gösterir.</string>
    <string name="setup_step3_action">İzin ver</string>
    <string name="setup_step3_secondary">Uygulama ayarları</string>
    <string name="setup_step4_title">Diğer uygulamaların üzerinde göster</string>
    <string name="setup_step4_body">Yalnızca başka bir uygulama açıkken hareket etmek için yüzen joystick kullanıyorsanız gerekir.</string>
    <string name="setup_step4_action">Ayarları aç</string>
    <string name="setup_step5_title">Kısıtlanmamış pil</string>
    <string name="setup_step5_body">Ekran uzun süre kapalı kaldığında sistemin simülasyonu durdurmaması için Samsung, Xiaomi ve Oppo cihazlarda önerilir.</string>
