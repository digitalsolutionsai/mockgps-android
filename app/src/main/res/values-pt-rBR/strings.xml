    <!-- adb screen -->
    <string name="adb_title">Controle com adb</string>
    <string name="adb_intro">Tudo pode ser acionado a partir de um computador, o que é útil para testes automatizados. O serviço exige a permissão android.permission.DUMP, então só este app e o adb shell podem controlá-lo; outros apps não.</string>
