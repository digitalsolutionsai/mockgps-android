    <!-- setup -->
    <string name="setup_title">Configuração inicial</string>
    <string name="setup_intro">O Android só permite que um app simule a localização depois que você o seleciona nas Opções do desenvolvedor. Você só precisa fazer isso uma vez.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (opcional)</string>
    <string name="setup_done">Concluído</string>
    <string name="setup_step1_title">Ative as Opções do desenvolvedor</string>
    <string name="setup_step1_body">Configurações → Sobre o telefone → Informações do software → toque 7 vezes em \"Número da versão\".</string>
    <string name="setup_step1_action">Abrir Sobre o telefone</string>
    <string name="setup_step2_title">Selecione o MockGPS como app de local fictício</string>
    <string name="setup_step2_body">Nas Opções do desenvolvedor, encontre \"Selecionar app de local fictício\" e escolha o MockGPS.</string>
    <string name="setup_step2_action">Abrir Opções do desenvolvedor</string>
    <string name="setup_step3_title">Permita localização e notificações</string>
    <string name="setup_step3_body">A localização permite que o MockGPS simule também a fonte fused, usada pela maioria dos apps. As notificações mostram o status e o botão Parar.</string>
    <string name="setup_step3_action">Conceder permissões</string>
    <string name="setup_step3_secondary">Configurações do app</string>
    <string name="setup_step4_title">Sobrepor a outros apps</string>
    <string name="setup_step4_body">Necessário apenas se você usa o joystick flutuante para se mover com outro app aberto.</string>
    <string name="setup_step4_action">Abrir configurações</string>
    <string name="setup_step5_title">Bateria sem restrições</string>
    <string name="setup_step5_body">Recomendado em Samsung, Xiaomi e Oppo para que o sistema não interrompa a simulação depois de muito tempo com a tela desligada.</string>
    <string name="setup_step5_action">Abrir configurações da bateria</string>
    <string name="setup_quick_title">Configuração rápida com adb</string>
    <string name="setup_quick_body">Pule as etapas 2 e 3 quando o telefone estiver conectado por um cabo de depuração:</string>
    <string name="setup_start">Começar</string>
    <string name="setup_finish_steps">Conclua as etapas 2 e 3 para continuar</string>
