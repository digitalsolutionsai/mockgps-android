    <!-- about screen -->
    <string name="about_title">Sobre</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">Uma ferramenta de simulação de localização para desenvolvedores e testadores testarem recursos baseados em localização. Desenvolvida pela DSAI (dsai.vn).</string>
    <string name="about_section_notes">Notas de uso</string>
    <string name="about_notes">O Android sempre marca localizações simuladas como mock (Location.isMock), então apps que verificam isso vão perceber. Use apenas para testar seus próprios apps. Não use para trapacear nem para violar os termos de outros serviços.</string>
    <string name="about_section_privacy">Privacidade</string>
    <string name="about_privacy">Sem anúncios, sem análises, sem contas e sem servidor próprio. Favoritos e configurações ficam apenas no seu dispositivo. Quando você pesquisa, planeja uma rota ou vê o mapa, o texto da busca e as coordenadas relacionadas são enviados diretamente aos serviços listados abaixo.</string>
    <string name="about_privacy_policy">Política de privacidade</string>
    <string name="about_section_third_party">Serviços e dados de terceiros</string>
    <string name="about_third_party">• Mapa: OpenFreeMap, dados © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Busca de endereços: Android Geocoder (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Rotas: OSRM em routing.openstreetmap.de (FOSSGIS)\n• Bibliotecas: MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">Copyright do OpenStreetMap</string>
