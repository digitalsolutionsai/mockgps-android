    <string name="adb_route_params">by: road (seguir as vias) ou deixe vazio para ligar os pontos em linha reta · travel: foot, bike, motorbike, car · end: stop, loop, pingpong · speed: km/h.</string>
    <string name="adb_section_controls">Controles</string>
