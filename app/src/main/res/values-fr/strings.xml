    <!-- about screen -->
    <string name="about_title">À propos</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">Un outil de simulation de position pour les développeurs et les testeurs qui veulent tester des fonctionnalités basées sur la localisation. Développé par DSAI (dsai.vn).</string>
    <string name="about_section_notes">Notes d\'utilisation</string>
    <string name="about_notes">Les positions simulées sont toujours signalées comme mock par Android (Location.isMock) : les applications qui le vérifient s\'en apercevront. À utiliser uniquement pour tester vos propres applications. Ne l\'utilisez pas pour tricher ni pour enfreindre les conditions d\'autres services.</string>
    <string name="about_section_privacy">Confidentialité</string>
    <string name="about_privacy">Aucune publicité, aucune analyse, aucun compte et aucun serveur à nous. Les favoris et les paramètres sont stockés uniquement sur votre appareil. Lorsque vous effectuez une recherche, planifiez un itinéraire ou consultez la carte, le texte de recherche et les coordonnées associées sont envoyés directement aux services listés ci-dessous.</string>
    <string name="about_privacy_policy">Politique de confidentialité</string>
    <string name="about_section_third_party">Services et données tiers</string>
    <string name="about_third_party">• Carte : OpenFreeMap, données © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• Recherche d\'adresses : Android Geocoder (Google), Photon (komoot), Nominatim (OpenStreetMap)\n• Itinéraires : OSRM sur routing.openstreetmap.de (FOSSGIS)\n• Bibliothèques : MapLibre Native (BSD-2-Clause), AndroidX, Jetpack Compose, Google Play services Location</string>
    <string name="about_osm_copyright">Copyright d\'OpenStreetMap</string>
