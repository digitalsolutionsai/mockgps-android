    <!-- setup -->
    <string name="setup_title">Configuration</string>
    <string name="setup_intro">Android ne permet à une application de simuler la position qu\'une fois que vous l\'avez sélectionnée dans les options pour les développeurs. Cette étape ne se fait qu\'une seule fois.</string>
    <!-- %1$s = step title -->
    <string name="setup_step_optional">%1$s (facultatif)</string>
    <string name="setup_done">Terminé</string>
    <string name="setup_step1_title">Activer les options pour les développeurs</string>
    <string name="setup_step1_body">Paramètres → À propos du téléphone → Informations sur le logiciel → appuyez 7 fois sur « Numéro de build ».</string>
    <string name="setup_step1_action">Ouvrir À propos du téléphone</string>
    <string name="setup_step2_title">Sélectionner MockGPS comme application de localisation fictive</string>
    <string name="setup_step2_body">Dans les options pour les développeurs, trouvez « Sélectionner l\'application de localisation fictive » et choisissez MockGPS.</string>
    <string name="setup_step2_action">Ouvrir les options pour les développeurs</string>
    <string name="setup_step3_title">Autoriser la localisation et les notifications</string>
    <string name="setup_step3_body">La localisation permet à MockGPS de simuler aussi la source fused, utilisée par la plupart des applications. Les notifications affichent l\'état et le bouton Arrêter.</string>
    <string name="setup_step3_action">Accorder les autorisations</string>
    <string name="setup_step3_secondary">Paramètres de l\'app</string>
    <string name="setup_step4_title">Afficher par-dessus les autres applications</string>
    <string name="setup_step4_body">Nécessaire uniquement si vous utilisez le joystick flottant pour vous déplacer pendant qu\'une autre application est ouverte.</string>
    <string name="setup_step4_action">Ouvrir les paramètres</string>
    <string name="setup_step5_title">Batterie sans restriction</string>
    <string name="setup_step5_body">Recommandé sur Samsung, Xiaomi et Oppo pour que le système n\'interrompe pas la simulation lorsque l\'écran reste éteint longtemps.</string>
    <string name="setup_step5_action">Ouvrir les paramètres de la batterie</string>
    <string name="setup_quick_title">Configuration rapide avec adb</string>
    <string name="setup_quick_body">Passez les étapes 2 et 3 lorsque le téléphone est branché avec un câble de débogage :</string>
