    <!-- adb screen -->
    <string name="adb_title">Contrôle avec adb</string>
    <string name="adb_intro">Tout peut être déclenché depuis un ordinateur, ce qui est pratique pour les tests automatisés. Le service exige l\'autorisation android.permission.DUMP : seuls cette application et adb shell peuvent donc le contrôler, pas les autres applications.</string>
