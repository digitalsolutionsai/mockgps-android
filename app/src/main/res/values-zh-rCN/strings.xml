    <!-- about screen -->
    <string name="about_title">关于</string>
    <!-- %1$s = version name -->
    <string name="about_app_version">MockGPS %1$s</string>
    <string name="about_description">面向开发者和测试人员的位置模拟工具，用于测试基于位置的功能。由 DSAI（dsai.vn）开发。</string>
    <string name="about_section_notes">使用说明</string>
    <string name="about_notes">模拟的位置始终会被 Android 标记为模拟位置（Location.isMock），因此会检查该标记的应用能够发现。请仅用于测试你自己的应用，不要用于作弊或违反其他服务的条款。</string>
    <string name="about_section_privacy">隐私</string>
    <string name="about_privacy">无广告、无统计分析、无账号，也没有我们自己的服务器。收藏和设置仅保存在你的设备上。当你搜索、规划路线或查看地图时，搜索文字和相关坐标会直接发送到下列服务。</string>
    <string name="about_privacy_policy">隐私政策</string>
    <string name="about_section_third_party">第三方服务和数据</string>
    <string name="about_third_party">• 地图：OpenFreeMap，数据 © OpenMapTiles © OpenStreetMap contributors (ODbL)\n• 地址搜索：Android Geocoder（Google）、Photon（komoot）、Nominatim（OpenStreetMap）\n• 路线规划：routing.openstreetmap.de 上的 OSRM（FOSSGIS）\n• 库：MapLibre Native (BSD-2-Clause)、AndroidX、Jetpack Compose、Google Play services Location</string>
    <string name="about_osm_copyright">OpenStreetMap 版权</string>
